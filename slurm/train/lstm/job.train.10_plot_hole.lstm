#!/bin/bash

#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --partition=gpu
#SBATCH --mem=16GB
#SBATCH --time=10:00:00
#SBATCH --account=rostamim_991
module purge
module load conda/23.3.1
conda init bash
source ~/.bashrc
conda activate csci544

cd ~/plot_hole_detection
python3 train.py --encoder_type all-MiniLM-L6-v2 --model lstm --n_stories 1000 --n_synth 10 --n_continuity_errors 10 > ~/results/output.train.10_plot_hole.lstm.txt

